# AI Web Agent Stack runtime secrets/config.
# The installer generates .env automatically. Do not commit real values.

SEARXNG_PORT=8080
SEARXNG_HOST=127.0.0.1
SEARXNG_VERSION=2026.9.8-3fdc6d753
# Canonical pins are synchronized by install/update.
CRAWL4AI_IMAGE=unclecode/crawl4ai@sha256:9021b3cb5c6f12570bbcd5395638495e0a06969b3148e377b953d174af2ebc9b

# Optional isolation; defaults preserve the standard deployment names.
COMPOSE_PROJECT_NAME=ai-web-agent-stack
SEARXNG_CONTAINER_NAME=searxng
CRAWL4AI_CONTAINER_NAME=crawl4ai
WEB_STACK_NETWORK=web-stack

CRAWL4AI_PORT=11235
CRAWL4AI_CONCURRENCY=2

# Generated by scripts/install.sh
CRAWL4AI_API_TOKEN=
SECRET_KEY=
REDIS_PASSWORD=
SEARXNG_SECRET=

# agent-browser encryption key is stored separately:
# state/agent-browser-encryption-key.env
