#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
ROOT="${WEB_STACK_HOME:-$(cd -- "$SCRIPT_DIR/.." && pwd)}"
COMPOSE_FILE="$ROOT/compose/docker-compose.yml"
ENV_FILE="$ROOT/.env"

# Optional compatibility: if this repository is used with the historical
# /mnt/MD path, the caller can export WEB_STACK_HOME explicitly.
if [[ ! -f "$COMPOSE_FILE" ]]; then
  printf 'Missing compose file: %s\n' "$COMPOSE_FILE" >&2
  exit 1
fi

if [[ ! -f "$ENV_FILE" ]]; then
  printf 'Missing environment file: %s\n' "$ENV_FILE" >&2
  printf 'Run ./scripts/install.sh first.\n' >&2
  exit 1
fi

set -a
# shellcheck source=/dev/null
source "$ENV_FILE"
set +a

: "${CRAWL4AI_API_TOKEN:?Missing CRAWL4AI_API_TOKEN in $ENV_FILE}"
CRAWL4AI_PORT="${CRAWL4AI_PORT:-11235}"
SEARXNG_PORT="${SEARXNG_PORT:-8080}"
NETWORK="${WEB_STACK_NETWORK:-web-stack}"

dc() {
  docker compose --env-file "$ENV_FILE" -f "$COMPOSE_FILE" "$@"
}

crawl4ai_curl() {
  printf 'Authorization: Bearer %s\n' "$CRAWL4AI_API_TOKEN" |
    command curl -fsS --max-time "${CURL_TIMEOUT:-15}" -H @- "$@"
}

wait_for_crawl4ai() {
  local base_url="http://127.0.0.1:${CRAWL4AI_PORT}"
  local status

  printf 'Waiting for Crawl4AI'

  for _ in $(seq 1 60); do
    status="$(
      crawl4ai_curl \
        --output /dev/null \
        --write-out '%{http_code}' \
        "$base_url/health" 2>/dev/null || true
    )"

    case "$status" in
      200|204)
        printf '\nCrawl4AI is responding at %s/health\n' "$base_url"
        return 0
        ;;
    esac

    printf '.'
    sleep 2
  done

  printf '\nCrawl4AI did not become ready in time.\n' >&2
  dc logs --tail=150 crawl4ai >&2
  return 1
}

wait_for_searxng() {
  for _ in $(seq 1 60); do
    if curl -fsS --max-time 3 -o /dev/null "http://127.0.0.1:$SEARXNG_PORT/" 2>/dev/null; then
      echo 'SearXNG is responding'
      return 0
    fi
    sleep 2
  done
  echo 'SearXNG did not become ready in time.' >&2
  return 1
}

verify_searxng() {
  curl -fsS \
    --max-time 15 \
    --get \
    --data-urlencode 'q=web stack verification' \
    --data-urlencode 'format=json' \
    "http://127.0.0.1:${SEARXNG_PORT}/search" |
    jq -e 'select(.results | type == "array" and length > 0) |
      {query, result_count: (.results | length)}'
}

verify_crawl4ai() {
  crawl4ai_curl \
    "http://127.0.0.1:${CRAWL4AI_PORT}/health" |
    jq -e '. | select(.status == "ok" and .version == "0.9.4")'

  crawl4ai_curl \
    "http://127.0.0.1:${CRAWL4AI_PORT}/openapi.json" |
    jq -e '.openapi and .paths["/md"].post and
      (.components.schemas.MarkdownRequest.required | index("url")) != null and
      (.components.schemas.FilterType.enum | index("fit")) != null and
      (.components.schemas.FilterType.enum | index("bm25")) != null' >/dev/null

  echo "Authenticated Crawl4AI OpenAPI: OK"

  local status markdown
  status="$(curl -sS --max-time 15 -o /dev/null -w '%{http_code}' \
    "http://127.0.0.1:${CRAWL4AI_PORT}/openapi.json")"
  [[ "$status" == 401 || "$status" == 403 ]] || {
    echo "FAIL: Crawl4AI permits unauthenticated OpenAPI access" >&2
    return 1
  }
  status="$(curl -sS --max-time 15 -o /dev/null -w '%{http_code}' \
    -H 'Content-Type: application/json' --data '{"url":"https://example.com","f":"fit"}' \
    "http://127.0.0.1:${CRAWL4AI_PORT}/md")"
  [[ "$status" == 401 || "$status" == 403 ]] || {
    echo "FAIL: Crawl4AI permits unauthenticated extraction" >&2
    return 1
  }
  echo "Unauthenticated OpenAPI and extraction rejected: OK"

  markdown="$("$ROOT/bin/web-read" https://example.com)"
  grep -Fq 'documentation examples' <<<"$markdown"
  echo "Real Crawl4AI fit extraction + shared validator: OK"
  markdown="$("$ROOT/bin/web-read" --query "example domain" https://example.com)"
  grep -Fq 'documentation examples' <<<"$markdown"
  echo "Real Crawl4AI BM25 extraction + shared validator: OK"
}

usage() {
  cat <<'USAGE'
Usage: web-stack COMMAND

Commands:
  up       Create the network and start SearXNG + Crawl4AI
  down     Stop the stack
  restart  Restart the stack
  status   Show services, network membership and endpoints
  logs     Follow Crawl4AI logs
  logs-search  Follow SearXNG logs
  verify   Test search, auth/OpenAPI, real fit/BM25 reads and Docker networking
USAGE
}

command_name="${1:-status}"

case "$command_name" in
  up)
    dc up -d
    wait_for_crawl4ai
    wait_for_searxng
    ;;

  down)
    dc down
    ;;

  restart)
    dc restart
    wait_for_crawl4ai
    wait_for_searxng
    ;;

  status)
    printf '%s\n' '--- Compose services ---'
    dc ps

    printf '\n%s\n' '--- Shared network members ---'
    docker network inspect "$NETWORK" \
      --format '{{range $id, $container := .Containers}}{{$container.Name}}{{"\n"}}{{end}}' |
      sort

    printf '\n%s\n' '--- Host endpoints ---'
    printf '%s\n' \
      "SearXNG:  http://127.0.0.1:${SEARXNG_PORT}" \
      "Crawl4AI: http://127.0.0.1:${CRAWL4AI_PORT}"

    printf '\n%s\n' '--- Docker-network endpoints ---'
    printf '%s\n' \
      'SearXNG:  http://searxng:8080' \
      'Crawl4AI: http://crawl4ai:11235'
    ;;

  logs)
    dc logs -f --tail=150 crawl4ai
    ;;

  logs-search)
    dc logs -f --tail=150 searxng
    ;;

  verify)
    printf '%s\n' '--- SearXNG ---'
    verify_searxng

    printf '\n%s\n' '--- Crawl4AI ---'
    verify_crawl4ai

    printf '\n%s\n' '--- Docker-network path ---'
    dc exec -T crawl4ai \
      curl -fsS \
      --max-time 15 \
      --get \
      --data-urlencode 'q=network verification' \
      --data-urlencode 'format=json' \
      'http://searxng:8080/search' |
      jq -e 'select(.results | type == "array" and length > 0) |
        {query, result_count: (.results | length)}'
    ;;

  -h|--help|help)
    usage
    ;;

  *)
    printf 'Unknown command: %s\n\n' "$command_name" >&2
    usage >&2
    exit 2
    ;;
esac
